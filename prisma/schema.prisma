// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tv {
  id        String   @id @default(cuid())
  name      String
  socketId  String?
  isOnline  Boolean  @default(false)
  volume    Int      @default(80)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaFile {
  id         String   @id @default(cuid())
  name       String
  filename   String
  filePath   String
  size       Int
  mimeType   String
  duration   Float?
  type       String   // 'video' | 'audio' | 'youtube'
  youtubeId  String?  // For YouTube videos: stores the video ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Playlist {
  id        String   @id @default(cuid())
  name      String
  type      String // 'video' | 'audio' | 'youtube'
  items     String // JSON string of media IDs in order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
